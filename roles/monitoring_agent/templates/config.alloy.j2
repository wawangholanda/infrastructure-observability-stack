logging {
  level = "info"
}

prometheus.exporter.unix "host" {
  procfs_path = "/host/proc"
  sysfs_path  = "/host/sys"
  rootfs_path = "/host/root"
}

prometheus.scrape "host" {
  targets = prometheus.exporter.unix.host.targets
  forward_to = [prometheus.remote_write.central.receiver]

  scrape_interval = "15s"
  scrape_timeout  = "10s"
}

prometheus.scrape "cadvisor" {
  targets = [
    {
      "__address__" = "cadvisor:8080",
      "job"         = "cadvisor",
      "instance"    = "{{ alloy_hostname_label }}",
    },
  ]

  forward_to      = [prometheus.remote_write.central.receiver]
  scrape_interval = "15s"
  scrape_timeout  = "10s"
}

prometheus.remote_write "central" {
  endpoint {
    url = "{{ alloy_prometheus_remote_write_url }}"
  }

  external_labels = {
    instance = "{{ alloy_hostname_label }}",
  }
}

{% if alloy_docker_log_targets | length > 0 %}
local.file_match "docker_app_logs" {
  path_targets = [
{% for target in alloy_docker_log_targets %}
    {
      __path__  = {{ target.path | to_json }},
      job       = "docker",
      instance  = {{ alloy_hostname_label | to_json }},
      container = {{ target.container | to_json }},
      image     = {{ target.image | to_json }},
    },
{% endfor %}
  ]
}

loki.process "docker_logs" {
  stage.docker {}

  forward_to = [loki.write.central.receiver]
}

loki.source.file "docker_app_logs" {
  targets    = local.file_match.docker_app_logs.targets
  forward_to = [loki.process.docker_logs.receiver]
}

loki.write "central" {
  endpoint {
    url = "{{ alloy_loki_push_url }}"
  }
}
{% endif %}
