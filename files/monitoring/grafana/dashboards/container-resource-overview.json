    {
      "id": 5,
      "title": "Host Disk Usage (%)",
      "type": "timeseries",
      "description": "Filesystem usage percentage per host and mountpoint. Virtual filesystems and common container overlay mountpoints are excluded.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "100 * (1 - (node_filesystem_avail_bytes{instance=~\"$host\",fstype!~\"tmpfs|devtmpfs|overlay|squashfs|nsfs|ramfs|proc|sysfs|cgroup2?|tracefs|debugfs|securityfs|pstore|mqueue|hugetlbfs|fusectl\",mountpoint!~\"/(run|var/lib/docker/.+|var/lib/containers/.+|snap/.+)\"} / node_filesystem_size_bytes{instance=~\"$host\",fstype!~\"tmpfs|devtmpfs|overlay|squashfs|nsfs|ramfs|proc|sysfs|cgroup2?|tracefs|debugfs|securityfs|pstore|mqueue|hugetlbfs|fusectl\",mountpoint!~\"/(run|var/lib/docker/.+|var/lib/containers/.+|snap/.+)\"}))",
          "legendFormat": "{{instance}} {{mountpoint}}",
          "refId": "A"
        }
      ]
    },
