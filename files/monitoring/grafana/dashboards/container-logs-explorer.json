            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "{job=\"docker\", instance=~\"$host\", container=~\"$container\"} |= \"$search\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "displayMode": "list"
      }
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "Top 10 HTTP Paths by Hits",
      "description": "Top 10 request paths from JSON REQUEST_LOG entries. The URL query string and hostname are excluded from grouping. Requires a non-empty URL field.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "topk(10, sum by (path) (count_over_time({job=\"docker\", instance=~\"$host\", container=~\"$container\"} | json | msg=\"REQUEST_LOG\" | URL != \"\" | __error__!=\"JSONParserErr\" | label_format path=`{{ regexReplaceAll \"\\\\?.*$\" (regexReplaceAll \"^[^/]+\" .URL \"\") \"\" }}` [$__range])))",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "valuePlacement": "right",
        "sizing": "auto",
        "minVizWidth": 0,
        "minVizHeight": 10,
        "maxVizHeight": 300,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        }
      },
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "mode": "seriesToRows",
            "reducers": [
              "lastNotNull"
            ]
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Last *",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Slow HTTP Requests (>300 ms)",
      "description": "HTTP requests with RequestDuration greater than 300 ms.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 36
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "{job=\"docker\", instance=~\"$host\", container=~\"$container\"}\n| json\n| msg=\"REQUEST_LOG\"\n| __error__=\"\"\n| RequestDuration > 300\n| line_format \"duration={{.RequestDuration}} ms | status={{.StatusCode}} | {{.URL}}\"",
          "queryType": "range",
          "maxLines": 100,
          "refId": "A"
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": false,
        "sortOrder": "Descending",
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "displayMode": "list"
      }
    }
